# MediShield Environment Configuration Template

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string
API_V1_STR=/api/v1

# PostgreSQL 16 Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medishield
POSTGRES_USER=medishield_user
POSTGRES_PASSWORD=medishield_password
DATABASE_URL=postgresql+asyncpg://medishield_user:medishield_password@localhost:5432/medishield
DATABASE_SYNC_URL=postgresql+psycopg2://medishield_user:medishield_password@localhost:5432/medishield

# Redis 7 (Async Jobs & Cache)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=medishield-storage
S3_REGION=us-east-1
S3_USE_SSL=false

# Vector DB (Qdrant / ChromaDB)
QDRANT_URL=http://localhost:6333

# Observability & Telemetry (Pydantic Logfire)
# Leave LOGFIRE_TOKEN empty for local offline console debugging
LOGFIRE_TOKEN=
LOGFIRE_SEND_TO_LOGFIRE=if-token-present
LOGFIRE_SERVICE_NAME=medishield

# Observability & Tracing (LangSmith)
# Set LANGSMITH_TRACING=true to enable end-to-end agent/tool tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medishield-local-dev
# Optional regional endpoint (e.g. https://eu.api.smith.langchain.com)
# LANGSMITH_ENDPOINT=
# Optional workspace ID
# LANGSMITH_WORKSPACE_ID=
# Omit case pseudonym by default (traces correlate via ephemeral root run ID)
LANGSMITH_INCLUDE_CASE_PSEUDONYM=false

# LLM Gateway (Groq)
# Provide your Groq API key (e.g. gsk_...) for hybrid unstructured extraction
GROQ_API_KEY=

GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,allam-2-7b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30.0

# Google Gemini (VLM Extraction for local dev)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
HF_API_KEY=
HF_VLM_MODEL=mistralai/Pixtral-12B-2409
HF_VLM_FALLBACK_MODELS=Qwen/Qwen2-VL-7B-Instruct,meta-llama/Llama-3.2-11B-Vision-Instruct

# Enable model & VLM fallback for unresolved OCR discrepancies (Spec 05 § 5)
ENABLE_MODEL_FALLBACK=false
