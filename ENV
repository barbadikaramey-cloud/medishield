# MediShield Environment Configuration Template

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string
API_V1_STR=/api/v1

# PostgreSQL 16 Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medishield
POSTGRES_USER=medishield_user
POSTGRES_PASSWORD=medishield_password
DATABASE_URL=postgresql+asyncpg://medishield_user:medishield_password@localhost:5432/medishield
DATABASE_SYNC_URL=postgresql+psycopg2://medishield_user:medishield_password@localhost:5432/medishield

# Redis 7 (Async Jobs & Cache)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=medishield-storage
S3_REGION=us-east-1
S3_USE_SSL=false

# Vector DB (Qdrant / ChromaDB)
QDRANT_URL=http://localhost:6333

# Observability & Telemetry (Pydantic Logfire)
# Leave LOGFIRE_TOKEN empty for local offline console debugging
